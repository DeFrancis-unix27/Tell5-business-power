# === TWILIO CONFIGURATION ===
# Required: Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=whatsapp:+14155238886

# === DATABASE CONFIGURATION ===
# Required: PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:5432/database
DATABASE_URL=postgres://user:password@host:5432/defaultdb?sslmode=require
AIVEN_CA_CERT_PATH=

# === SESSION CONFIGURATION ===
# Required: Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be at least 32 characters for security
SESSION_SECRET=replace_with_a_long_random_secret

# === COOKIE CONFIGURATION ===
# Set to True in production (over HTTPS only)
# Set to False for local development (HTTP)
COOKIE_SECURE=False

# === APPLICATION CONFIGURATION ===
# Optional: Email address to grant admin access
ADMIN_EMAIL=owner@example.com

# Optional: Gemini API key for AI message analysis (Tier 1 - Acceptor)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Optional: Groq API key (Tier 2 - Customer Service)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Mistral API key (Tier 3 - Orchestrator)
# Get from: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Optional: OpenRouter API key (Gemini fallback + Tier 2 provider)
# Free tier: https://openrouter.ai/keys  (no credit card needed)
# Falls back automatically if Gemini fails
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-405b-instruct

# Optional: MongoDB MCP connection string (MongoDB partner integration)
# This enables the AI pipeline to store/retrieve conversation data in MongoDB
# If you get TLS handshake errors, append: ?tls=true&tlsAllowInvalidCertificates=true
MDB_MCP_CONNECTION_STRING=
MDB_MCP_READ_ONLY=false
MDB_MCP_DB_NAME=tell5

# Optional: Google Cloud Agent Builder / Discovery Engine
# Service account JSON key file path, or paste JSON into GOOGLE_APPLICATION_CREDENTIALS_JSON on hosts that support env secrets
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_CLOUD_PROJECT=tell5
AGENT_BUILDER_LOCATION=global
AGENT_BUILDER_DATA_STORE=

# Optional: Google OAuth for social login
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=/api/auth/google/callback

# Optional: Sentry DSN for error tracking in production
# Get from: https://sentry.io
SENTRY_DSN=

# === DEBUG & ENVIRONMENT ===
# DEBUG: Set to False in production
DEBUG=True
# ENVIRONMENT: development, staging, or production
ENVIRONMENT=development
