FROM node:20-slim AS bot-stage

WORKDIR /app
COPY services/whatsapp/package*.json ./services/whatsapp/
RUN cd services/whatsapp && npm install --production

FROM python:3.12-slim

WORKDIR /app

# Install Python deps + Node.js runtime for the Baileys WhatsApp bot
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential libffi-dev libssl-dev ca-certificates gnupg && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" > /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY --from=bot-stage /app/services/whatsapp/node_modules ./services/whatsapp/node_modules
COPY . .

RUN chmod +x start.sh && \
    groupadd -r tell5 && useradd -r -g tell5 -d /app -s /sbin/nologin tell5 && \
    chown -R tell5:tell5 /app

USER tell5

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -sf http://localhost:${PORT:-8000}/healthz || exit 1

EXPOSE 8000

CMD ./start.sh
